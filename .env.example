# ─── BOT ───────────────────────────────────────────
BOT_TOKEN=your_bot_token_here
BOT_USERNAME=your_bot_username_here

# ─── USERBOT (GramJS) ──────────────────────────────
API_ID=12345
API_HASH=your_api_hash_here
SESSION_STRING=your_session_string_here

# ─── ADMINS ─────────────────────────────────────────
# Space-separated Telegram user IDs (numeric)
ADMINS=123456789 987654321

# ─── CHANNELS / GROUPS TO INDEX ─────────────────────
# Space-separated chat IDs (use negative IDs for groups/channels)
# e.g. -1001234567890 -1009876543210
CHANNELS=-1001234567890

# ─── RATE LIMIT ─────────────────────────────────────
# Seconds a user must wait between inline searches
RATE_LIMIT_SECONDS=10

# ─── SEARCH ─────────────────────────────────────────
# Max results per inline page
MAX_RESULTS=10

# ─── MESSAGES ───────────────────────────────────────
START_MSG=Hi! I'm a Media Search Bot.\nUse inline mode to search: @botusername query
